# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitewise_agent

# ==================== JWT AUTH ====================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256

# ==================== OLLAMA / LLM ====================
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b

# ==================== SERVICE PORTS ====================
